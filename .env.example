# Dapatkan dari @BotFather di Telegram
TELEGRAM_TOKEN=isi telegram token di sini

# Dapatkan dari https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=isi gemini api di sini

# Model bisa diganti kalau Google mengubah daftar model gratis
GEMINI_MODEL=gemini-3.5-flash-lite

# Opsional: batasi siapa yang boleh pakai bot (ID Telegram, pisahkan koma).
# Kosongkan = semua orang boleh. Cek ID kamu lewat bot @userinfobot.
ALLOWED_USER_IDS=